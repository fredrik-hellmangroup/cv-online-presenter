@page "/"
@page "/services"
@page "/contact"
@page "/projects"
@page "/cv"
@page "/projects/{Slug}"
@using System.Text.Json
@inject SiteContent Content
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IHostEnvironment HostEnvironment
@inject IWebHostEnvironment WebHost
@inject ReleaseIdentity ReleaseIdentity

@if (page is not null)
{
    <PageTitle>@fullTitle</PageTitle>
    <HeadContent>
        <meta name="description" content="@(page.Description)" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@Content.Settings.SiteName" />
        <meta property="og:locale" content="@(page.Locale.Replace('-', '_'))" />
        <meta property="og:title" content="@fullTitle" />
        <meta property="og:description" content="@(page.Description)" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="@fullTitle" />
        <meta name="twitter:description" content="@(page.Description)" />
        @if (canonicalUrl is not null)
        {
            <link rel="canonical" href="@canonicalUrl" />
            <meta property="og:url" content="@canonicalUrl" />
            <meta name="twitter:url" content="@canonicalUrl" />
        }
        @if (structuredData is not null)
        {
            <script type="application/ld+json">@((MarkupString)structuredData)</script>
        }
    </HeadContent>
}
else
{
    <PageTitle>Sidan hittades inte · @Content.Settings.SiteName</PageTitle>
    <HeadContent>
        <meta name="robots" content="noindex, nofollow" />
    </HeadContent>
}

<a class="skip-link" href="#main">Hoppa till innehåll</a>
<header class="site-header">
    <div class="brand-wrap">
        <span id="brand-mark" class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path class="brand-mark-links" d="M5 17 12 6l7 11M5 17h14" />
                <circle cx="12" cy="6" r="2.1" />
                <circle cx="5" cy="17" r="1.7" />
                <circle cx="19" cy="17" r="1.7" />
            </svg>
        </span>
        <a class="brand" href="/"
           aria-label="Hem – @Content.Settings.SiteName">Hem</a>
    </div>
    <nav aria-label="Huvudnavigation">
        <a href="/services" aria-current="@(path == "/services" ? "page" : null)">Kompetens</a>
        <a href="/projects" aria-current="@(path == "/projects" || path.StartsWith("/projects/", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Projekt</a>
        <a href="/cv" aria-current="@(path == "/cv" ? "page" : null)">CV</a>
        <a href="/contact" aria-current="@(path == "/contact" ? "page" : null)">Kontakt</a>
    </nav>
    @if (page is not null && constellationJson is not null)
    {
        <button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" hidden><span class="motion-toggle-icon" aria-hidden="true"></span><span class="visually-hidden">Pausa bakgrundsanimation</span></button>
    }
    @if (page is not null)
    {
        <button id="theme-toggle" type="button" aria-pressed="true" hidden>Växla tema</button>
    }
</header>
<main id="main" class="@(isHome ? "home" : null)">
    @if (cv is not null)
    {
        <CvHero View="cv" PhotoUrl="@photoUrl" PdfUrl="@pdfUrl" HistoryId="@cv.HistoryId" />
    }
    <div class="page-layout">
        @if (isCv)
        {
            <aside id="cv-toc" class="cv-toc" aria-label="Innehållsförteckning" hidden>
                <p class="cv-toc-title">Innehåll</p>
                <ol id="cv-toc-list"></ol>
            </aside>
        }
        <article class="@(cv is not null ? "cv" : hero is not null ? "wide" : null)">
            @if (page is not null)
            {
                @if (cv is not null)
                {
                    @((MarkupString)cv.BeforeHistoryHtml)
                    @((MarkupString)cv.HistoryHeadingHtml)
                    <GitLog Assignments="cv.Assignments" HeadLabel="@(cv.Kicker ?? cv.Name)" />
                    @((MarkupString)cv.AssignmentsHtml)
                    @((MarkupString)cv.AfterHistoryHtml)
                }
                else if (path == "/projects")
                {
                    @((MarkupString)LeadHtml(Content.Render(page)))
                    <div class="project-grid">
                        @foreach (var project in Content.PublishedProjects.OrderBy(ProjectMetadata.Order).ThenBy(item => item.Title, StringComparer.CurrentCulture))
                        {
                            var technologies = ProjectMetadata.Technologies(project);
                            var cardMeta = ProjectMetadata.CardMeta(project);
                            <div class="project-card" data-keywords="@(technologies.Count > 0 ? string.Join("|", technologies) : null)">
                                @if (cardMeta.Length > 0)
                                {
                                    <p class="project-card-meta">@cardMeta</p>
                                }
                                <h2><a href="/@project.Slug">@project.Title</a></h2>
                                <p class="project-card-description">@ProjectMetadata.Text(project, "summary")</p>
                                @if (technologies.Count > 0)
                                {
                                    <ul class="tags">
                                        @foreach (var technology in technologies)
                                        {
                                            <li>@technology</li>
                                        }
                                    </ul>
                                }
                                <p class="project-card-link"><a href="/@project.Slug">Läs om uppdraget &rarr;</a></p>
                            </div>
                        }
                    </div>
                }
                else if (page.Type == "project" && path.StartsWith("/projects/", StringComparison.OrdinalIgnoreCase))
                {
                    <ProjectDetails Document="page" Sections="Content.Snapshot.Sections[page.Slug]" />
                }
                else
                {
                    @if (hero is not null)
                    {
                        var showTechniques = Content.Cv is { SkillGroups.Count: > 0 };
                        var kicker = ProjectMetadata.Text(page, "kicker");
                        var panelEyebrow = ProjectMetadata.Text(page, "panelEyebrow");
                        var panelTitle = ProjectMetadata.Text(page, "panelTitle");
                        <section class="page-hero">
                            <div class="page-hero-copy">
                                @if (kicker.Length > 0)
                                {
                                    <p class="page-hero-kicker">@kicker</p>
                                }
                                @((MarkupString)hero.HeadingHtml)
                                <div class="page-hero-lead">@((MarkupString)hero.LeadHtml)</div>
                                <p class="page-hero-actions">
                                    @if (showTechniques)
                                    {
                                        <a class="button-link primary" href="#service-technologies-heading">Se teknikerna <span aria-hidden="true">↓</span></a>
                                    }
                                    <a class="button-link" href="/cv">Se demo-CV</a>
                                </p>
                            </div>
                            <aside class="page-hero-panel" aria-label="@(panelTitle.Length > 0 ? panelTitle : "Delar")">
                                @if (panelEyebrow.Length > 0)
                                {
                                    <p class="page-hero-kicker">@panelEyebrow</p>
                                }
                                @if (panelTitle.Length > 0)
                                {
                                    <p class="page-hero-panel-title">@panelTitle</p>
                                }
                                @if (hero.Groups.Count > 0)
                                {
                                    <div class="hero-tabs" data-hero-tabs>
                                        @foreach (var group in hero.Groups)
                                        {
                                            <section class="hero-tab-panel" data-hero-tab-panel>
                                                <h2 class="hero-tab-heading" data-hero-tab-label>@group.Heading</h2>
                                                @if (group.LeadHtml.Length > 0)
                                                {
                                                    <div class="hero-tab-lead">@((MarkupString)group.LeadHtml)</div>
                                                }
                                                <ul class="page-hero-list">
                                                    @foreach (var item in group.Items)
                                                    {
                                                        <li>
                                                            <strong>@item.Heading</strong>
                                                            <div class="page-hero-item-text">@((MarkupString)item.BodyHtml)</div>
                                                        </li>
                                                    }
                                                </ul>
                                            </section>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <ul class="page-hero-list">
                                        @foreach (var item in hero.Items)
                                        {
                                            <li>
                                                <strong>@item.Heading</strong>
                                                <div class="page-hero-item-text">@((MarkupString)item.BodyHtml)</div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </aside>
                        </section>
                    }
                    else
                    {
                        @((MarkupString)Content.Render(page))
                    }
                    @if (string.Equals(path, "/services", StringComparison.OrdinalIgnoreCase) && Content.Cv is { SkillGroups.Count: > 0 } servicesCv)
                    {
                        var technologyCount = servicesCv.SkillGroups.Sum(group => group.Skills.Count);
                        <section class="service-technologies" aria-labelledby="service-technologies-heading">
                            <h2 id="service-technologies-heading">Teknik i uppdragen</h2>
                            <p class="constellation-legend">Bakgrunden är en karta över teknikerna: varje prick är en teknik och linjerna binder ihop tekniker som använts i samma uppdrag. Välj ett område eller en teknik nedan så lyser de upp i kartan.</p>
                            <div class="tech-panel">
                                <div class="tech-filter">
                                    <label class="visually-hidden" for="technology-filter">Filtrera tekniker</label>
                                    <input id="technology-filter" data-tech-filter type="search" aria-controls="service-skill-groups"
                                           placeholder="Filtrera tekniker…" autocomplete="off" />
                                    <span class="tech-count" data-tech-count aria-live="polite" aria-atomic="true">@technologyCount tekniker</span>
                                </div>
                                <p class="tech-status" data-pin-status role="status" aria-live="polite" aria-atomic="true"></p>
                                <div id="service-skill-groups" class="skill-groups service-skill-groups">
                                    @foreach (var group in servicesCv.SkillGroups)
                                    {
                                        <div class="skill-group" role="group" aria-label="@group.Name" data-keywords="@string.Join("|", group.Skills)">
                                            <p class="skill-group-name"><button type="button" class="skill-group-btn" data-group="@group.Name" aria-pressed="false">@group.Name <span class="skill-group-count">@CvPresenter.TechnologyCount(group.Skills.Count)</span></button></p>
                                            <ul class="skill-chips">
                                                @foreach (var skill in group.Skills)
                                                {
                                                    <li data-tech-item><button type="button" class="skill-btn" data-skill="@skill" aria-pressed="false">@skill</button></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                                <p class="tech-empty" data-tech-empty hidden>Inga tekniker matchar din sökning.</p>
                            </div>
                        </section>
                    }
                    @if (string.Equals(path, "/services", StringComparison.OrdinalIgnoreCase))
                    {
                        <aside class="service-cv-cta" aria-label="Fördjupad profil">
                            <p>Vill du läsa mer om erfarenhet och uppdrag?</p>
                            <a class="button-link primary" href="/cv">Se fullständigt CV</a>
                        </aside>
                    }
                }
                @if (path == "/contact")
                {
                    <ContactSection Email="@Content.Settings.ContactEmail" />
                    <h2 id="utforska">Fortsätt utforska</h2>
                    <p>Välj den del av profilen som bäst svarar mot din fråga.</p>
                    <div class="project-grid">
                        @foreach (var (route, index) in new[] { "/services", "/projects", "/cv" }.Select((route, index) => (route, index)))
                        {
                            var target = Content.FindByPath(route);
                            if (target is null) continue;
                            <div class="project-card">
                                <p class="project-card-meta">@((index + 1).ToString("00"))</p>
                                <h2><a href="@route">@target.Title</a></h2>
                                <p class="project-card-description">@target.Description</p>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <h1>Sidan hittades inte</h1>
                <p>Adressen är fel eller sidan har flyttats.</p>
                <p><a href="/">Till startsidan</a></p>
            }
        </article>
    </div>
</main>
@if (isCv)
{
    <div id="cv-search" class="cv-search" hidden>
        <div id="cv-search-panel" class="cv-search-panel" role="search" hidden>
            <label for="cv-search-input">Sök i CV:t</label>
            <input id="cv-search-input" type="search" maxlength="100" autocomplete="off"
                   placeholder="Sök kompetens, roll, bransch…" />
            <ul id="cv-search-results" aria-live="polite"></ul>
        </div>
        <button id="cv-search-toggle" type="button" aria-expanded="false" aria-controls="cv-search-panel">
            <span>Sök</span><kbd aria-hidden="true">Ctrl K</kbd>
        </button>
    </div>
}
<footer>
    <span>© @DateTime.UtcNow.Year @(Content.Settings.CompanyName ?? "· Egenföretagare")</span>
    <a href="/contact">Kontakt</a>
</footer>
@if (page is not null)
{
    @if (constellationJson is not null)
    {
        <div id="constellation-data" data-json="@constellationJson" hidden></div>
    }
    <div id="easter-egg" class="easter-egg" role="status" hidden>
        <p>✨ Du hittade en liten detalj i portfoliomallen.</p>
        <button id="easter-egg-close" type="button">Stäng</button>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private ContentDocument? page;
    private CvView? cv;
    private PageHeroView? hero;
    private string? photoUrl;
    private string? pdfUrl;
    private string? constellationJson;
    private string path = "/";
    private string canonicalPath = "/";
    private bool isCv => page is not null && path == "/cv";
    private bool isHome => page is not null && path == "/";
    // A title that already names the site (the home page) is used as is, so the name is not repeated.
    private string fullTitle => page is null || page.Title.Contains(Content.Settings.SiteName,
StringComparison.OrdinalIgnoreCase)
        ? page?.Title ?? string.Empty
        : $"{page.Title} · {Content.Settings.SiteName}";


    private string? canonicalUrl => page is null || Content.SiteUrl is null ? null : Content.SiteUrl + canonicalPath;

    // The page heading and the introduction before the first section; sections of the editorial list are replaced by the cards.
    private static string LeadHtml(string html)
    {
        var firstSection = html.IndexOf("<h2", StringComparison.OrdinalIgnoreCase);
        return firstSection < 0 ? html : html[..firstSection];
    }

    private string VersionedAsset(string assetPath) => ReleaseIdentity.AppRevision.Length == 40
        && ReleaseIdentity.AppRevision.All(character => character is >= '0' and <= '9' or >= 'a' and <= 'f')
            ? $"{assetPath}?v={ReleaseIdentity.AppRevision}"
            : assetPath;
    private string? structuredData => page is null || canonicalUrl is null ? null : JsonSerializer.Serialize(new object[]
    {
        new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["name"] = Content.Settings.SiteName,
            ["url"] = Content.SiteUrl + "/",
            ["inLanguage"] = page.Locale
        },
        new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebPage",
            ["name"] = fullTitle,
            ["description"] = page.Description,
            ["url"] = canonicalUrl,
            ["inLanguage"] = page.Locale
        }
    });

    protected override void OnParametersSet()
    {
        path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        page = Content.FindByPath(path);
        canonicalPath = page is null
            ? path
            : SiteContent.CoreRoutes.FirstOrDefault(route => string.Equals(route.Value, page.Slug, StringComparison.OrdinalIgnoreCase)).Key
                ?? $"/{page.Slug}";
        var cvView = Content.Cv;
        cv = isCv ? cvView : null;
        hero = page is not null && page.Type == "page" && string.Equals(path, "/services", StringComparison.OrdinalIgnoreCase)
            ? PageHero.Build(Content.Render(page))
            : null;
        photoUrl = cv is not null &&  WebHost.WebRootFileProvider.GetFileInfo("img/profile.webp").Exists
            ? VersionedAsset("/img/profile.webp")
            : null;
        // The download button appears only when a PDF has been placed in wwwroot/downloads.
        pdfUrl = cv is not null && WebHost.WebRootFileProvider.GetFileInfo("downloads/cv.pdf").Exists
            ? VersionedAsset("/downloads/cv.pdf")
            : null;
        constellationJson = cvView is { SkillGroups.Count: > 0 }
            ? JsonSerializer.Serialize(
                new { groups = cvView.SkillGroups, assignments = cvView.Assignments.Select(item => new { item.Title, item.Keywords }) },
                JsonSerializerOptions.Web)
            : null;
        var context = HttpContextAccessor.HttpContext;
        if (page is null && context is not null)
        {
            context.Response.StatusCode = StatusCodes.Status404NotFound;
            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
        }
        else if (context is not null && (!HostEnvironment.IsProduction() || Content.SiteUrl is null))
            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
    }
}
