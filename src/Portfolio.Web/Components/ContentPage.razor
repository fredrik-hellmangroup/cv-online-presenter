@page "/"
@page "/profile"
@page "/services"
@page "/contact"
@page "/projects"
@page "/cv"
@page "/projects/{Slug}"
@inject SiteContent Content
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IHostEnvironment HostEnvironment

@if (page is not null)
{
    <PageTitle>@fullTitle</PageTitle>
    <HeadContent>
        <meta name="description" content="@(page.Description)" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@fullTitle" />
        <meta property="og:description" content="@(page.Description)" />
        @if (Content.SiteUrl is not null)
        {
            <link rel="canonical" href="@(Content.SiteUrl + path)" />
            <meta property="og:url" content="@(Content.SiteUrl + path)" />
        }
    </HeadContent>
}
else
{
    <PageTitle>Sidan hittades inte · @Content.Settings.SiteName</PageTitle>
    <HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
}

<a class="skip-link" href="#main">Hoppa till innehåll</a>
<header>
    <a class="brand" href="/">@Content.Settings.SiteName</a>
    <nav aria-label="Huvudnavigation">
        <a href="/profile">Profil</a>
        <a href="/services">Tjänster</a>
        <a href="/projects">Projekt</a>
        <a href="/cv">CV</a>
        <a href="/search">Sök</a>
        <a href="/contact">Kontakt</a>
    </nav>
    <button id="command-open" type="button" aria-haspopup="dialog" aria-controls="command-palette" hidden>Sök</button>
    @if (page is not null)
    {
        <button id="theme-toggle" type="button" aria-pressed="false" hidden>Växla tema</button>
    }
</header>
<main id="main">
    <article>
        @if (page is not null)
        {
            @((MarkupString)Content.Render(page))
            @if (path == "/contact" && IsValidEmail(Content.Settings.ContactEmail))
            {
                <p><a href="mailto:@Content.Settings.ContactEmail">@Content.Settings.ContactEmail</a></p>
            }
        }
        else
        {
            <h1>Sidan hittades inte</h1>
            <p>Adressen är fel eller sidan har flyttats.</p>
            <p><a href="/">Till startsidan</a></p>
        }
    </article>
</main>
<footer>
    <span>@Content.Settings.SiteName</span>
    @if (page is not null)
    {
        <button id="easter-egg-toggle" type="button" aria-expanded="false" aria-controls="easter-egg" hidden>Visa en överraskning</button>
        <p id="easter-egg" hidden>✨ Du hittade en liten detalj i portfoliomallen.</p>
    }
</footer>

@code {
    [Parameter] public string? Slug { get; set; }

    private ContentDocument? page;
    private string path = "/";
    private string fullTitle => $"{page?.Title} · {Content.Settings.SiteName}";

    protected override void OnParametersSet()
    {
        path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        page = Content.FindByPath(path);
        var context = HttpContextAccessor.HttpContext;
        if (page is null && context is not null)
        {
            context.Response.StatusCode = StatusCodes.Status404NotFound;
            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
        }
        else if (context is not null && (!HostEnvironment.IsProduction() || Content.SiteUrl is null))
            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
    }

    private static bool IsValidEmail(string? value) =>
        !string.IsNullOrWhiteSpace(value) && System.Net.Mail.MailAddress.TryCreate(value, out var address) && address.Address == value;
}
