@using Microsoft.AspNetCore.Components.Forms
@using Portfolio.Experience
@inject ContactFormSettings Settings
@inject ContactSubmissionService Submissions
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject ILogger<ContactSection> Logger

@if (hasEmail && Settings.IsEnabled)
{
    <section class="contact-card" aria-labelledby="contact-form-title">
        <p class="contact-eyebrow">Hör av dig</p>
        <h2 id="contact-form-title">Skriv ett meddelande</h2>

        @if (Sent == "1")
        {
            <p class="contact-notice contact-success" role="status">Tack! Ditt meddelande är skickat – jag återkommer så snart jag kan.</p>
        }
        else
        {
            @if (failure is not null)
            {
                <div class="contact-notice contact-alert" role="alert" tabindex="-1" autofocus>
                    <p>@failure</p>
                </div>
            }
            <EditForm Model="Form!" FormName="contact" OnSubmit="SubmitAsync" class="contact-form">
                <div class="contact-field">
                    <label for="contact-name">Namn</label>
                    <input id="contact-name" name="Form.Name" value="@Form!.Name" autocomplete="name" required maxlength="@ContactSubmissionService.MaxNameLength"
                               aria-invalid="@Invalid(ContactField.Name)" aria-describedby="@Describe(ContactField.Name, "contact-name-error")" />
                    @if (invalidFields.Contains(ContactField.Name))
                    {
                        <p id="contact-name-error" class="contact-error">Ange ditt namn.</p>
                    }
                </div>
                <div class="contact-field">
                    <label for="contact-email">E-post</label>
                    <input id="contact-email" name="Form.Email" type="email" value="@Form!.Email" autocomplete="email" required maxlength="@ContactSubmissionService.MaxEmailLength"
                               aria-invalid="@Invalid(ContactField.Email)" aria-describedby="@Describe(ContactField.Email, "contact-email-error")" />
                    @if (invalidFields.Contains(ContactField.Email))
                    {
                        <p id="contact-email-error" class="contact-error">Ange en giltig e-postadress så att jag kan svara.</p>
                    }
                </div>
                <div class="contact-field">
                    <label for="contact-message">Meddelande</label>
                    <textarea id="contact-message" name="Form.Message" rows="6" required
                                   minlength="@ContactSubmissionService.MinMessageLength" maxlength="@ContactSubmissionService.MaxMessageLength"
                                   aria-invalid="@Invalid(ContactField.Message)" aria-describedby="@Describe(ContactField.Message, "contact-message-error")">@Form!.Message</textarea>
                    @if (invalidFields.Contains(ContactField.Message))
                    {
                        <p id="contact-message-error" class="contact-error">Skriv minst @ContactSubmissionService.MinMessageLength och högst @ContactSubmissionService.MaxMessageLength tecken.</p>
                    }
                </div>
                <div class="contact-hp" aria-hidden="true">
                    <label>Lämna detta fält tomt <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
                </div>
                <div class="cf-turnstile" data-sitekey="@Settings.SiteKey" data-language="sv"></div>
                <noscript><p class="contact-error">Verifieringen kräver JavaScript. Mejla mig i stället på <a href="mailto:@Email">@Email</a>.</p></noscript>
                <div class="contact-actions">
                    <button type="submit" class="contact-submit">Skicka meddelande</button>
                    <a href="@MailtoHref">eller mejla direkt</a>
                </div>
            </EditForm>
            <script src="@(ContactFormSettings.TurnstileOrigin)/turnstile/v0/api.js" async defer></script>
        }
    </section>
}
else if (hasEmail)
{
    <section class="contact-card" aria-labelledby="contact-card-title">
        <p class="contact-eyebrow">Hör av dig</p>
        <h2 id="contact-card-title">Har du ett uppdrag eller en idé?</h2>
        <p>Berätta kort vad det gäller så återkommer jag så snart jag kan.</p>
        <p class="contact-actions">
            <a class="button-link primary" href="@MailtoHref">Skriv till @Email</a>
        </p>
    </section>
}

@code {
    [Parameter] public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "sent")] public string? Sent { get; set; }

    [SupplyParameterFromForm] private ContactInput? Form { get; set; }
    protected override void OnInitialized() => Form ??= new();

    private IReadOnlyList<ContactField> invalidFields = [];
    private string? failure;

    private bool hasEmail => !string.IsNullOrWhiteSpace(Email)
        && System.Net.Mail.MailAddress.TryCreate(Email, out var address) && address.Address == Email;
    private const string MailSubject = "Kaffe och en .NET-fråga?";
    private const string MailBody = "Hej Fredrik! Jag såg din portfolio och skulle gärna prata om…";
    private string MailtoHref => $"mailto:{Email}?subject={Uri.EscapeDataString(MailSubject)}&body={Uri.EscapeDataString(MailBody)}";

    private string? Invalid(ContactField field) => invalidFields.Contains(field) ? "true" : null;
    private string? Describe(ContactField field, string id) => invalidFields.Contains(field) ? id : null;

    private async Task SubmitAsync(EditContext _)
    {
        var context = HttpContextAccessor.HttpContext!;
        var form = context.Request.Form;
        ContactResult result;
        try
        {
            result = await Submissions.SubmitAsync(
                Email!,
                new ContactSubmission(Form!.Name, Form.Email, Form.Message, form["website"], form["cf-turnstile-response"], context.Connection.RemoteIpAddress?.ToString()),
                context.RequestAborted);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogError(exception, "Contact form submission failed");
            failure = "Meddelandet kunde inte skickas just nu. Försök igen om en stund eller mejla mig direkt.";
            return;
        }

        switch (result.Outcome)
        {
            case ContactOutcome.Sent:
                Navigation.NavigateTo("/contact?sent=1");
                break;
            case ContactOutcome.Invalid:
                invalidFields = result.InvalidFields;
                failure = "Kontrollera fälten nedan och försök igen.";
                break;
            default:
                failure = "Verifieringen misslyckades. Försök igen.";
                break;
        }
    }
}
