{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/source-map.schema.json",
  "title": "Content source map",
  "description": "Hand-written mapping from canonical source material to generated Markdown pages. bootstrapOutputSha256 is tool bootstrap metadata and must cover exactly the mapped page paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "generatedPages",
    "bootstrapOutputSha256"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "Hand-written source-map format version."
    },
    "source": {
      "const": "content/sources/master-cv.md",
      "description": "Hand-written canonical source path."
    },
    "generatedPages": {
      "type": "array",
      "minItems": 4,
      "description": "Hand-written list and metadata for every generated page. The generator derives the complete output allowlist from these paths.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/page"
          },
          {
            "$ref": "#/$defs/project"
          }
        ]
      }
    },
    "bootstrapOutputSha256": {
      "type": "object",
      "description": "Tool-written bootstrap metadata: SHA-256 for the initial contents of exactly the page paths listed in generatedPages.",
      "propertyNames": {
        "pattern": "^content/pages/(?:cv|home|services|projects)\\.md$(?![\\s\\S])|^content/pages/projects/(?!(?:(?:con|prn|aux|nul|com[1-9]|lpt[1-9]))\\.md$)[a-z0-9]+(?:-[a-z0-9]+)*\\.md$(?![\\s\\S])"
      },
      "patternProperties": {
        "^content/pages/(?:cv|home|services|projects)\\.md$(?![\\s\\S])|^content/pages/projects/(?!(?:(?:con|prn|aux|nul|com[1-9]|lpt[1-9]))\\.md$)[a-z0-9]+(?:-[a-z0-9]+)*\\.md$(?![\\s\\S])": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "basePage": {
      "type": "object",
      "required": [
        "path",
        "type",
        "title",
        "description",
        "locale",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^content/pages/(?!profile\\.md$|contact\\.md$|demo-profile\\.md$).+\\.md$",
          "description": "Hand-written generated Markdown path under content/pages."
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written page title."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written page description."
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written locale, which must also be listed by site settings."
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ],
          "description": "Hand-written publication status."
        },
        "sourceSection": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written source-section reference."
        },
        "sourceSections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Hand-written source-section references."
        },
        "sourceHeading": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written source heading for a project."
        },
        "heroTagline": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written, source-backed homepage tagline."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Hand-written, source-backed project summary."
        },
        "links": {
          "type": "string",
          "minLength": 1,
          "description": "Optional hand-written project links field; omitted when not supplied."
        },
        "approvedCvPublicationText": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "employmentLine"
          ],
          "description": "Optional hand-written exact-line publication override. It applies only when source exactly matches the configured source line.",
          "properties": {
            "employmentLine": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "published"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^- [^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$",
                  "description": "Exact hand-written source line to match."
                },
                "published": {
                  "type": "string",
                  "pattern": "^- [^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$",
                  "description": "Hand-written replacement line to publish."
                }
              }
            }
          }
        },
        "competenceBlocks": {
          "type": "array",
          "minItems": 1,
          "description": "Hand-written source-backed grouped competencies.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "sourceLines"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "sourceLines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "selectedProjects": {
          "type": "array",
          "minItems": 1,
          "description": "Hand-written cards that select mapped project details.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "path",
              "summary"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^/projects/(?!(?:(?:con|prn|aux|nul|com[1-9]|lpt[1-9]))$)[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "page": {
      "allOf": [
        {
          "$ref": "#/$defs/basePage"
        },
        {
          "properties": {
            "type": {
              "const": "page"
            },
            "path": {
              "enum": [
                "content/pages/cv.md",
                "content/pages/home.md",
                "content/pages/services.md",
                "content/pages/projects.md"
              ],
              "description": "One of the four editorial pages rendered by the generator."
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "content/pages/cv.md"
              }
            },
            "required": [
              "path"
            ]
          },
          "else": {
            "not": {
              "required": [
                "approvedCvPublicationText"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "type": "object"
    },
    "project": {
      "allOf": [
        {
          "$ref": "#/$defs/basePage"
        },
        {
          "properties": {
            "type": {
              "const": "project"
            },
            "path": {
              "type": "string",
              "pattern": "^content/pages/projects/(?!(?:(?:con|prn|aux|nul|com[1-9]|lpt[1-9]))\\.md$)[a-z0-9]+(?:-[a-z0-9]+)*\\.md$(?![\\s\\S])",
              "description": "Hand-written project detail path; every mapped project page is generated."
            }
          },
          "required": [
            "type",
            "summary",
            "sourceHeading",
            "sourceSection"
          ]
        },
        {
          "not": {
            "required": [
              "approvedCvPublicationText"
            ]
          }
        }
      ],
      "unevaluatedProperties": false,
      "type": "object"
    }
  }
}
