{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cv-sections.schema.json",
  "title": "CV section configuration",
  "description": "Hand-written CV publication configuration. Optional headings overrides use known structural heading keys; omitted keys retain the generator defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "Hand-written configuration format version."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Hand-written section publication rules for source CV sections.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "required",
          "publish"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "description": "Hand-written source section heading."
          },
          "required": {
            "type": "boolean",
            "description": "Hand-written flag controlling whether the source section must exist."
          },
          "publish": {
            "type": "boolean",
            "description": "Hand-written flag controlling whether the source section is published."
          }
        }
      }
    },
    "headings": {
      "type": "object",
      "description": "Optional hand-written overrides for known generator structural heading keys.",
      "additionalProperties": false,
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "competenceAreas": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "projectHistory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "employment": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "projectResult": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "projectKeywords": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "selectedProjects": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "projectSummary": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "projectResponsibilities": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        },
        "projectTechnology": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\v\\f\\u0085\\u2028\\u2029]+$"
        }
      }
    }
  }
}
